# Puerto del servidor (Cloud Run asigna 8080 automáticamente)
PORT=8080

# ─── Wompi (Pasarela de Pago) ────────────────────────────────────────────────
# Obtener en: https://dashboard.wompi.co
WOMPI_PUBLIC_KEY=pub_test_...
WOMPI_PRIVATE_KEY=prv_test_...
WOMPI_INTEGRITY_SECRET=test_integrity_...

# ─── Email (Gmail SMTP) ──────────────────────────────────────────────────────
# Usar contraseña de aplicación de Google (no la contraseña normal)
EMAIL_USER=tu-correo@gmail.com
EMAIL_PASS=xxxx-xxxx-xxxx-xxxx
EMAIL_COMPRADOR=correo-comprador@ejemplo.com
EMAIL_VENDEDOR=correo-vendedor@ejemplo.com

# ─── Integración con otros módulos ───────────────────────────────────────────
# Clave compartida con el módulo carrito (debe coincidir con PAGOS_API_KEY del carrito)
PAGOS_API_KEY=clave-secreta-pagos-equipo4

# Secreto para firmar webhooks HMAC-SHA256 hacia el carrito
# Debe coincidir con PAGOS_WEBHOOK_SECRET del módulo carrito
PAGOS_WEBHOOK_SECRET=secreto-webhook-compartido

# URL del microservicio carrito (para enviar webhook de pago confirmado)
CARRITO_SERVICE_URL=https://carrito-srv-xxxxx-uc.a.run.app

# ─── CORS ────────────────────────────────────────────────────────────────────
# URL del frontend de pagos (para CORS)
FRONTEND_URL=https://pagos-frontend-xxxxx-uc.a.run.app

# Orígenes adicionales separados por coma (opcional)
# ALLOWED_ORIGINS=https://pagos-frontend-xxxxx-uc.a.run.app,https://carrito-frontend-xxxxx-uc.a.run.app
